# Flask
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string

# Database  (postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DBNAME)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/portfolio_dev

# CORS - the origin your React dev server runs on (Vite default shown)
CORS_ORIGINS=http://localhost:5173

# Cookies / security
#   In production set these to True (requires HTTPS). Leave False for local http.
SESSION_COOKIE_SECURE=False
COOKIE_SAMESITE=Lax

# Storage
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=storage
# Max upload size in megabytes
MAX_UPLOAD_MB=100

# GitHub integration (personal access token, read-only public scope is enough)
GITHUB_TOKEN=
# Max size (KB) of a repo text file whose content we cache in Postgres
GITHUB_MAX_CONTENT_KB=512

# ---- future object storage (not used while STORAGE_BACKEND=local) ----
# R2_ENDPOINT=
# R2_ACCESS_KEY=
# R2_SECRET_KEY=
# R2_BUCKET=
# R2_PUBLIC_URL=
